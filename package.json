{
	"name": "somson-mobile",
	"version": "0.0.1",
	"author": "Ionic Framework",
	"homepage": "https://ionicframework.com/",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint --fix",
		"format": "prettier --write \"src/**/*.{ts,js,html,css,scss}\"",
		"pretty-quick": "pretty-quick --staged",
		"lint-staged": "lint-staged",
		"prepare": "husky",
		"ionic:build": "ng build --configuration production",
		"ionic:serve": "ng serve",
		"cap:sync": "cap sync",
		"cap:ios": "cap open ios",
		"cap:android": "cap open android",
		"cap:add:ios": "cap add ios",
		"cap:add:android": "cap add android",
		"cap:dev:ios": "ng build --configuration development && cap sync ios && cap run ios",
		"cap:dev:android": "ng build --configuration development && cap sync android && cap run android",
		"cap:prod:ios": "ng build --configuration production && cap sync ios && cap run ios",
		"cap:prod:android": "ng build --configuration production && cap sync android && cap run android"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^21.2.5",
		"@angular/common": "^21.2.5",
		"@angular/compiler": "^21.2.5",
		"@angular/core": "^21.2.5",
		"@angular/forms": "^21.2.5",
		"@angular/platform-browser": "^21.2.5",
		"@angular/platform-browser-dynamic": "^21.2.5",
		"@angular/router": "^21.2.5",
		"@capacitor/android": "^8.2.0",
		"@capacitor/app": "8.0.1",
		"@capacitor/core": "8.2.0",
		"@capacitor/haptics": "8.0.1",
		"@capacitor/ios": "^8.2.0",
		"@capacitor/keyboard": "8.0.1",
		"@capacitor/status-bar": "8.0.1",
		"@ionic/angular": "^8.8.1",
		"@ngx-translate/core": "^17.0.0",
		"@ngx-translate/http-loader": "^17.0.0",
		"ionicons": "^8.0.13",
		"rxjs": "~7.8.2",
		"tailwindcss": "^4.2.2",
		"tslib": "^2.8.1",
		"zone.js": "~0.16.1"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^21.2.3",
		"@angular-eslint/builder": "^21.3.1",
		"@angular-eslint/eslint-plugin": "^21.3.1",
		"@angular-eslint/eslint-plugin-template": "^21.3.1",
		"@angular-eslint/schematics": "^21.3.1",
		"@angular-eslint/template-parser": "^21.3.1",
		"@angular/cli": "^21.2.3",
		"@angular/compiler-cli": "^21.2.5",
		"@angular/language-service": "^21.2.5",
		"@capacitor/cli": "8.2.0",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@commitlint/types": "^20.5.0",
		"@eslint/js": "^10.0.1",
		"@ionic/angular-toolkit": "^12.3.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/jasmine": "~6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.57.1",
		"@typescript-eslint/parser": "^8.57.1",
		"angular-eslint": "21.3.1",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^62.8.0",
		"eslint-plugin-prefer-arrow": "1.2.3",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jasmine-core": "~6.1.0",
		"jasmine-spec-reporter": "~7.0.0",
		"karma": "~6.4.4",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.1",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.2.0",
		"lint-staged": "^16.4.0",
		"postcss": "^8.5.3",
		"prettier": "^3.8.1",
		"pretty-quick": "^4.2.2",
		"tailwindcss": "^4.1.12",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.1"
	},
	"description": "An Ionic project"
}
